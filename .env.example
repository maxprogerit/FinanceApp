# ============================================================
# Example environment variables for production deployment.
# Copy this to .env on your server and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# Server
PORT=8081

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/financedb
DB_USERNAME=financeapp
DB_PASSWORD=your_strong_db_password_here

# JWT (generate with: openssl rand -base64 64)
JWT_SECRET=your_very_long_random_jwt_secret_here_min_256_bits
JWT_EXPIRATION_MS=86400000

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# SendGrid / SMTP
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=your_sendgrid_api_key_here
MAIL_FROM=noreply@yourdomain.com

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# App
FRONTEND_URL=https://yourdomain.com
